# ====================================================
# CEBECI MEDIKAL - ENVIRONMENT CONFIGURATION (SAMPLE)
# ====================================================
# Copy this file to .env and configure your production values.

# 1. Database Connection (PostgreSQL or SQLite)
DATABASE_URL="postgresql://user:password@localhost:5432/cebecimedikal?schema=public"

# 2. Production Domain URLs
NEXT_PUBLIC_SITE_URL="https://cebecimedikal.com"
SITE_URL="https://cebecimedikal.com"

# 3. Security & JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET="your_production_grade_jwt_secret_key_here"
ADMIN_SESSION_SECRET="your_production_grade_session_secret_key_here"

# 4. Administrator Provisioning Credentials (Used during `npm run seed`)
ADMIN_EMAIL="admin@cebecimedikal.com"
ADMIN_PASSWORD="YourStrongAdminPassword2026!"
ADMIN_NAME="Cebeci Yönetici"

EDITOR_EMAIL="editor@cebecimedikal.com"
EDITOR_PASSWORD="YourStrongEditorPassword2026!"
EDITOR_NAME="İçerik Editörü"

SALES_EMAIL="sales@cebecimedikal.com"
SALES_PASSWORD="YourStrongSalesPassword2026!"
SALES_NAME="Satış Temsilcisi"
